[Unit]
Description=SmartWay Homework Web Service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/SmartWay
EnvironmentFile=-/etc/smartway.env
ExecStart=/usr/local/bin/node /root/SmartWay/server.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
